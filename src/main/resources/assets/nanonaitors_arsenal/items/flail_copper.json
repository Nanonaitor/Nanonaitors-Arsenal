{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "on_false": {"type": "minecraft:model", "model": "nanonaitors_arsenal:item/flail_copper"},
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [{
        "when": ["firstperson_lefthand", "firstperson_righthand", "thirdperson_lefthand", "thirdperson_righthand"],
        "model": {"type": "minecraft:empty"}
      }, {
        "when": "gui",
        "model": {"type": "minecraft:model", "model": "nanonaitors_arsenal:item/flail_swinging_copper"}
      }],
      "fallback": {"type": "minecraft:model", "model": "nanonaitors_arsenal:item/flail_copper"}
    }
  }
}
